# Local same-origin development. Use the same value for the Vite proxy target.
RECLAIM_ENV=development
RECLAIM_DATA_DIR=./backend/data
RECLAIM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
RECLAIM_COOKIE_SECURE=false
RECLAIM_SESSION_HOURS=24
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api/v1
